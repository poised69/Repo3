# ---------------------------------------------------------------------------
# POD Town configuration. Copy to `.env` and fill in. `.env` is gitignored.
#
#   cp .env.example .env
#
# NEVER commit real tokens. NEVER paste them into a chat or an issue.
# ---------------------------------------------------------------------------

# --- Make.com -------------------------------------------------------------
# Read-only Make API token (Make → Profile → API → Add token).
#
# !! IMPORTANT !! Before creating this token, ROTATE the old one. A live Make
# API bearer token is currently hardcoded in plaintext inside scenario 6868468
# ("POD - Operational Health & Weekly Digest") in HTTP modules 6, 7 and 8, so
# it is readable by anyone who can view that scenario's blueprint. Rotate it in
# Make, then update those three modules, then issue the new read-only token
# below. See README.md § Security.
#
# Scopes needed (read-only): scenarios:read
MAKE_API_TOKEN=

# Make zone host for this account (confirmed: eu1).
MAKE_API_BASE=https://eu1.make.com/api/v2

# --- Telegram -------------------------------------------------------------
# Bot token for the "BBW" bot (Make connection 9456263). Ask @BotFather, or
# reuse the existing bot's token. Sensitive - treat like a password.
#
# Leave BLANK to run in Make-only mode: the three scheduled/on-demand scenarios
# still animate, and BBW shows a generic "running" state without knowing which
# route fired. Nothing breaks.
TELEGRAM_BOT_TOKEN=

# Optional, cosmetic only - shown in the UI. e.g. BBW_pod_bot
TELEGRAM_BOT_USERNAME=

# The chat the BBW buttons are pressed in. Updates from other chats are ignored.
TELEGRAM_CHAT_ID=8268657606

# --- Server ---------------------------------------------------------------
PORT=4173
# Bind address. Keep 127.0.0.1 so the app is reachable only from this machine.
HOST=127.0.0.1

# --- Polling --------------------------------------------------------------
# Make's API rate limit on this account's Core plan is 60 requests/minute.
# Defaults below use ~38 req/min, leaving comfortable headroom.
# BBW is polled faster because it drives 7 of the 10 buildings.
MAKE_POLL_BBW_MS=4000
MAKE_POLL_SCENARIO_MS=8000
TELEGRAM_POLL_MS=2000
